APP_NAME="Donnees Territoriales SN"
APP_ENV=testing
# APP_KEY volontairement vide (secret jamais committé — scan GitGuardian) :
# une clé est générée dans l'image à la construction (cf. Dockerfile,
# php artisan key:generate) et docker-compose fournit APP_KEY en env var.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgis
DB_PORT=5432
DB_DATABASE=donnees_territoriales_sn
DB_USERNAME=postgres
DB_PASSWORD=postgres

CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=4
